# 06. Prod-only: any destroy, or a modify on a stateful resource

import "tfplan/v2" as tfplan
import "tfrun"

is_prod_workspace = tfrun.workspace.name matches "-prod$"

stateful_types = [
	"azurerm_key_vault",
	"azurerm_key_vault_secret",
	"azurerm_key_vault_certificate",
	"azurerm_postgresql_flexible_server",
	"azurerm_storage_account",
	"azurerm_eventhub",
	"azurerm_eventhub_namespace",
	"azurerm_eventhub_authorization_rule",
	"azurerm_user_assigned_identity",
	"azurerm_federated_identity_credential",
]

destructive_changes = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
	rc.change.actions contains "delete"
}

stateful_modify_changes = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
	rc.type in stateful_types and
	rc.change.actions contains "update"
}

main = rule {
	(not is_prod_workspace) or (length(destructive_changes) is 0 and length(stateful_modify_changes) is 0)
}
